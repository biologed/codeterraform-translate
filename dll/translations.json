// Словарь перевода. Формат файла - JSON, но с комментариями (их читает
// сам загрузчик, см. Translate::Reload), так что пометки можно оставлять
// прямо здесь.
//
// Поддерживаются два вида файла:
//   1) плоский:      {"Start Game": "Начать игру", ...}
//   2) с настройками: {"settings": {...}, "translations": {...}}  <- этот
{
    "settings": {
        // ЗОНЫ, КОТОРЫЕ НЕЛЬЗЯ ПЕРЕВОДИТЬ.
        //
        // В игре пользователь сам пишет текст: код в редакторе и вывод его
        // программ в консоли. Этот текст лежит в том же DOM, и без такого
        // списка словарь начинает "переводить" написанное игроком: набрал в
        // редакторе ON - на экране стало ВКЛ, и код сломался.
        //
        // Список ДОПОЛНЯЕТ встроенный (поля ввода, contenteditable,
        // популярные веб-редакторы - см. kDefaultSkipSelectors в
        // translate.cpp). Чтобы встроенный не применялся, добавьте
        // "useDefaultSkipSelectors": false.
        //
        // Как подобрать свой селектор: в игре навести мышь на нужную панель
        // (или поставить курсор в поле) и нажать F7 - в translator_log.txt и
        // dump_focus.txt будет путь до элемента, его классы и подсказка,
        // что можно дописать сюда.
        "skipSelectors": [
            ".cm-editor",             // редактор кода (CodeMirror) целиком
            ".cm-content",            // сам текст программы внутри редактора
            ".console-line-output",   // вывод программы игрока в консоли
            ".player-copy-surface"    // области, помеченные игрой как текст игрока
        ]
    },

    // Сам словарь: "как в игре": "как показать".
    //
    // Значение можно записать и объектом, если фразу нужно переводить
    // ТОЛЬКО в одном месте:
    //   "to"     - перевод;
    //   "only"   - переводить только внутри этого CSS-селектора;
    //   "except" - не переводить внутри этого селектора.
    // Так решается случай со словом, которое одновременно является командой
    // игры: в разделе помощи его перевести надо, а больше нигде - нельзя.
    "translations": {
        "Continue": "Продолжить",
        "Settings": "Настройки",
        "Exit": "Выход",
        "Loading...": "Загрузка...",
        "Save": "Сохранить",
        "Back": "Назад",

        // Пример перевода "только в разделе помощи": .docs-panel-root -
        // это панель документации игры.
        "boot": { "to": "загрузка", "only": ".docs-panel-root" }
    }
}
